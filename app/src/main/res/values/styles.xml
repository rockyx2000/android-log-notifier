<resources>
    <!-- セクション見出し: 小さく・字間を空けた英字ラベル -->
    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Btn">
        <item name="android:layout_height">44dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="BtnSolid" parent="Btn">
        <item name="android:background">@drawable/btn_solid</item>
        <item name="android:textColor">@color/bg</item>
    </style>
    <style name="BtnOutline" parent="Btn">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <!-- 設定行: 左にラベル、右に状態。タップで該当の設定へ -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/row_ripple</item>
    </style>
    <style name="RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>
</resources>
